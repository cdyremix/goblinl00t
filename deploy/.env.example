# Goblin L00t — production environment.
# Copy to `.env` (in this `deploy/` directory) and fill in real values.
# `docker compose --env-file .env up -d` will pick it up automatically.
#
# Anything marked REQUIRED will fail compose if left blank.

############################################
# Public-facing domain (no scheme, no path)
############################################
# REQUIRED. Used for Stripe webhook URL, Twitch OAuth redirect, and
# Clerk proxy host resolution. Must match what's in DNS.
PUBLIC_HOST=goblinl00t.com

# Host port nginx binds to. Leave 80 unless you front this with another
# reverse proxy on the host that terminates TLS and forwards plain HTTP.
HTTP_PORT=80

############################################
# Postgres
############################################
POSTGRES_USER=goblin
POSTGRES_DB=goblin
# REQUIRED. Strong random string — `openssl rand -hex 32` is fine.
POSTGRES_PASSWORD=CHANGE_ME

############################################
# Logging
############################################
LOG_LEVEL=info

############################################
# Clerk (auth)
############################################
# REQUIRED. From your Clerk instance — Production keys (pk_live_… / sk_live_…).
# The publishable key is consumed at BUILD TIME by Vite, so re-build the
# `app` image whenever you rotate it: `docker compose build app init-static`.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_SECRET_KEY=sk_live_REPLACE_ME

############################################
# Twitch
############################################
# REQUIRED for Twitch sign-in. From dev.twitch.tv app registration.
TWITCH_CLIENT_ID=REPLACE_ME
TWITCH_CLIENT_SECRET=REPLACE_ME
# Optional — only needed for the chat bot to actually JOIN channels and
# read/write chat. The bot stays offline (API still works) without it.
TWITCH_OAUTH_TOKEN=
TWITCH_BOT_USERNAME=goblinl00t
TWITCH_CHANNEL=goblinl00t

############################################
# Session signing (Twitch state HMAC, Steam OAuth cookie HMAC)
############################################
# REQUIRED. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

############################################
# Admin allowlist
############################################
# Comma-separated emails. First sign-in with one of these auto-promotes
# isAdmin + flips tier to `pro`. Defaults to c.borawa@gmail.com.
SUPER_USER_EMAILS=

############################################
# Maintenance kill-switch (optional)
############################################
# Leave empty for normal operation. Set to "1" to FORCE maintenance ON
# regardless of the admin Switch — useful for emergency lockdowns.
MAINTENANCE_MODE=

############################################
# Stripe
############################################
# REQUIRED. Use live keys for production.
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# Optional but recommended — the publishable key. Server-side it's only
# round-tripped to a couple of read endpoints; the browser bundle reads
# it from VITE_CLERK_PUBLISHABLE_KEY's sibling at build time if you want
# Stripe.js client-side.
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# Optional — only needed if you want to verify webhook signatures
# manually. The bundled stripe-replit-sync auto-registers a managed
# webhook on boot (using PUBLIC_HOST) and stores its signing secret.
STRIPE_WEBHOOK_SECRET=

############################################
# DB schema sync at boot (optional)
############################################
# The container entrypoint runs `drizzle-kit push` on every start so
# the schema is kept in sync with the deployed code. It's idempotent
# (no-op when the schema already matches), but if you'd rather drive
# schema changes manually, set this to "false" and run them with:
#   docker compose exec app pnpm --filter @workspace/db run push
RUN_DB_PUSH=true
